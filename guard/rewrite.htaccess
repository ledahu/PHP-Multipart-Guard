# =====================================================================
#  MULTIPART GUARD — mod_rewrite edition (NOT RECOMMENDED)
#
#  Kept for comparison only. Use guard/multipart-guard.htaccess instead.
#  Known weakness: a sub-folder whose .htaccess contains
#  "RewriteEngine Off" disables these rules for that folder.
#
#  No generic POST size check. Put at the TOP of .htaccess.
# =====================================================================

# --- SETTINGS --------------------------------------------------------

# MODE: remove the "#" to switch to OBSERVE (nothing blocked, only logged).
#SetEnvIf Request_URI ^ MPG_OBSERVE=1

RewriteEngine On

# Run these rules BEFORE the rules of sub-folder .htaccess files
# (otherwise a sub-folder with "RewriteEngine On" replaces them).
RewriteOptions InheritDownBefore

# --- 0. Internal redirect of a refused request ------------------------
# (for example ErrorDocument 403 pointing to a PHP script): refuse it too.
RewriteCond %{ENV:REDIRECT_MPG} ^deny
RewriteCond %{ENV:REDIRECT_MPG_OBSERVE} !=1
RewriteRule ^ - [F]

# --- 1. Detection -----------------------------------------------------
# Original request only. "multipart" anywhere in Content-Type, any case.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{HTTP:Content-Type} multipart [NC]
RewriteRule ^ - [E=MPG:seen]

# --- 2. Allowed URLs ----------------------------------------------------
# Exact path, case-sensitive. One "!=" line per allowed URL.
RewriteCond %{ENV:MPG} =seen
RewriteCond %{REQUEST_URI} !=/multipart2hell/site/upload.php
RewriteCond %{REQUEST_URI} !=/multipart2hell/site/api/upload
RewriteRule ^ - [E=MPG:deny_not_allowed]

# --- 3. On an allowed URL, accept only what a real browser sends -------
RewriteCond %{ENV:MPG} =seen
RewriteCond %{REQUEST_METHOD} !=POST
RewriteRule ^ - [E=MPG:deny_method]

RewriteCond %{ENV:MPG} =seen
RewriteCond %{HTTP:Content-Type} !^multipart/form-data;\ ?boundary=("?)[0-9A-Za-z'()+_./:=?-]{1,70}\1$ [NC]
RewriteRule ^ - [E=MPG:deny_bad_ctype]

RewriteCond %{ENV:MPG} =seen
RewriteCond %{HTTP:Content-Length} !^[0-9]{1,15}$
RewriteRule ^ - [E=MPG:deny_no_length]

# Maximum size in bytes (10 MB).
RewriteCond %{ENV:MPG} =seen
RewriteCond expr "%{HTTP:Content-Length} -gt 10485760"
RewriteRule ^ - [E=MPG:deny_too_large]

RewriteCond %{ENV:MPG} =seen
RewriteRule ^ - [E=MPG:allow]

# --- 4. Enforce -------------------------------------------------------
RewriteCond %{ENV:MPG} ^deny
RewriteCond %{ENV:MPG_OBSERVE} !=1
RewriteRule ^ - [F]

# =====================================================================
#  END OF MULTIPART GUARD
# =====================================================================
